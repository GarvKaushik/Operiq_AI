# Infrastructure (docker compose)
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# Public URL of the dashboard. OAuth redirects and download links use it.
APP_URL=http://localhost:3000
# Where the Next.js dashboard proxies /api/* requests
API_URL=http://localhost:4000
API_PORT=4000

# Secrets: generate each with `openssl rand -base64 32`
ENCRYPTION_KEY=
SIGNING_SECRET=

# LLM (any OpenAI-compatible endpoint: Ollama Cloud, local Ollama, ...)
OPENAI_BASE_URL=https://ollama.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-oss:120b

# Telegram (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Google OAuth client (Sheets + Calendar APIs enabled)
# Redirect URI: <APP_URL>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack app (OAuth v2). Redirect URL: <APP_URL>/api/oauth/slack/callback (Slack requires https)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Files and reports
STORAGE_DIR=./storage
DOWNLOAD_LINK_TTL_HOURS=24

# Default timezone for calendar events
TIMEZONE=UTC
